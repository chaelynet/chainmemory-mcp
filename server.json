{
  "$schema": "https://static.modelcontextprotocol.io/schemas/2025-12-11/server.schema.json",
  "name": "io.github.chaelynet/chainmemory",
  "description": "Cross-model, cryptographically verifiable memory for Claude, ChatGPT, and any AI agent — own your AI's memory and carry it across every model.",
  "repository": {
    "url": "https://github.com/chaelynet/chainmemory-mcp",
    "source": "github"
  },
  "version": "2.5.6",
  "packages": [
    {
      "registryType": "npm",
      "identifier": "chainmemory-mcp",
      "version": "2.5.6",
      "transport": {
        "type": "stdio"
      },
      "environmentVariables": [
        {
          "description": "ChainMemory API key. REQUIRED for every tool except chainmemory_seal. Get one at https://faucet.chainmemory.ai",
          "isRequired": true,
          "format": "string",
          "isSecret": true,
          "name": "CHAINMEMORY_API_KEY"
        },
        {
          "description": "API base URL (default: https://api.chainmemory.ai)",
          "isRequired": false,
          "format": "string",
          "isSecret": false,
          "name": "CHAINMEMORY_API_BASE"
        },
        {
          "description": "Private key for AICHAIN wallet",
          "isRequired": false,
          "format": "string",
          "isSecret": true,
          "name": "AICHAIN_KEY"
        },
        {
          "description": "RPC endpoint (default: https://rpc.chainmemory.ai)",
          "isRequired": false,
          "format": "string",
          "isSecret": false,
          "name": "AICHAIN_RPC"
        }
      ]
    }
  ]
}
